AI_APP_NAME=SmartFactory DSS AI Service
AI_APP_ENV=local
AI_APP_VERSION=0.1.0
AI_API_VERSION=v1
AI_INTERNAL_TOKEN=
AI_LOG_LEVEL=INFO
AI_DOCS_ENABLED=true
AI_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
AI_MAX_REQUEST_BYTES=1048576
AI_HOST=127.0.0.1
AI_PORT=8001

# Shared read-only dataset root for Step 21C verification and later ML training
AI_DATASET_ROOT=
AI_DATASET_MANIFEST_MAX_BYTES=1048576
AI_DATASET_FILE_MAX_BYTES=536870912
AI_DATASET_MAX_ROWS_PER_FILE=1000000

# Step 21D deterministic data-quality validation and preprocessing
AI_PREPROCESSING_ROOT=
AI_PREPROCESSING_MAX_STORED_ISSUES=10000
AI_PREPROCESSING_MAX_UNIQUE_VALUES=50000
AI_PREPROCESSING_FAIL_ON_REJECTED=false
# Step 21E leakage-safe feature engineering and chronological splits
AI_FEATURE_ROOT=
AI_FEATURE_TRAIN_RATIO=0.70
AI_FEATURE_VALIDATION_RATIO=0.15
AI_FEATURE_TEST_RATIO=0.15

# Step 21F reproducible model training and private registry
AI_MODEL_ROOT=
AI_MODEL_RANDOM_SEED=42
AI_MODEL_ANOMALY_CONTAMINATION=0.02
AI_MODEL_MANIFEST_MAX_BYTES=1048576
AI_MODEL_ARTIFACT_MAX_BYTES=536870912
AI_MODEL_METRICS_MAX_BYTES=10485760

# Phase 7 Step 22A - private local Ollama foundation
AI_OLLAMA_ENABLED=true
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=llama3:8b
AI_OLLAMA_TAGS_ENDPOINT=/api/tags
AI_OLLAMA_CONNECT_TIMEOUT_SECONDS=2
AI_OLLAMA_TIMEOUT_SECONDS=5
AI_OLLAMA_MAX_REQUEST_BYTES=262144
AI_OLLAMA_MAX_RESPONSE_BYTES=1048576
AI_OLLAMA_USER_AGENT=SmartFactory-DSS-AI/0.1

# Phase 7 Step 22D - guarded explanation generation endpoint
AI_OLLAMA_GENERATE_ENDPOINT=/api/chat
AI_OLLAMA_GENERATION_TIMEOUT_SECONDS=90
AI_OLLAMA_NUM_PREDICT=768
AI_EXPLANATION_RATE_LIMIT_PER_MINUTE=6
AI_EXPLANATION_MAX_CONCURRENT_REQUESTS=1
AI_EXPLANATION_MAX_PAYLOAD_BYTES=131072
AI_EXPLANATION_MAX_OUTPUT_BYTES=32768
AI_EXPLANATION_GENERATION_ATTEMPTS=2
