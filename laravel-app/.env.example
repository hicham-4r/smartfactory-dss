APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
AUTH_PASSWORD_TIMEOUT=900



PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
DB_QUEUE_RETRY_AFTER=7500

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
PRODUCTION_RECORD_EDIT_WINDOW_HOURS=48
ERP_CONNECTOR=simulated_sage
ERP_SIMULATED_SAGE_BASE_URL=https://sage-erp-simulator.test
ERP_SIMULATED_SAGE_TOKEN=
ERP_SIMULATED_SAGE_VERIFY_TLS=true
ERP_SIMULATED_SAGE_HEALTH_ENDPOINT=/api/health
ERP_SIMULATOR_API_TOKEN=
ERP_SIMULATOR_ENFORCE_HTTPS=true
ERP_SIMULATOR_MAXIMUM_PAGE_SIZE=200
ERP_SIMULATOR_CURSOR_TTL_SECONDS=3600
ERP_SIMULATOR_RATE_LIMIT_PER_MINUTE=120
ERP_SYNC_PAGE_SIZE=100
ERP_SYNC_MAX_PAGES_PER_RESOURCE=10000
ERP_SYNC_LEASE_TTL_SECONDS=300
ERP_CONNECT_TIMEOUT_SECONDS=5
ERP_REQUEST_TIMEOUT_SECONDS=20
ERP_RETRY_ATTEMPTS=3
ERP_RETRY_DELAY_MILLISECONDS=250
ERP_RETRY_MAXIMUM_DELAY_MILLISECONDS=5000
ERP_PAGE_SIZE=100
ERP_MAXIMUM_PAGE_SIZE=200
ERP_MAXIMUM_RESPONSE_BYTES=5242880
ERP_USER_AGENT=SmartFactory-DSS/1.0
ERP_SYNC_OVERLAP_SECONDS=300
ERP_INITIAL_LOOKBACK_DAYS=30
ERP_LOG_CHANNEL=stack
ERP_SYNC_AUTOMATION_ENABLED=false
ERP_SYNC_AUTOMATION_CRON="*/15 * * * *"
ERP_SYNC_AUTOMATION_TIMEZONE=UTC
ERP_SYNC_AUTOMATION_PER_PAGE=100
ERP_SYNC_AUTOMATION_MAX_PAGES=100
ERP_SYNC_AUTOMATION_LOCK_KEY=smartfactory:erp:incremental-sync-cycle
ERP_SYNC_AUTOMATION_LOCK_SECONDS=7200
ERP_SYNC_AUTOMATION_SCHEDULE_MUTEX_MINUTES=120
ERP_MONITORING_SOURCE_SYSTEM=simulated_sage
ERP_MONITORING_STALE_AFTER_MINUTES=45
ERP_MONITORING_WINDOW_HOURS=24
ERP_MONITORING_RECENT_FAILURE_LIMIT=20
ERP_MANUAL_SYNC_QUEUE=erp-sync
ERP_MANUAL_SYNC_COOLDOWN_SECONDS=300
ERP_MANUAL_SYNC_PER_PAGE=100
ERP_MANUAL_SYNC_MAX_PAGES=100
ERP_MANUAL_SYNC_LOCK_SECONDS=7200
ERP_MANUAL_SYNC_RETRY_AFTER_SECONDS=60

# Phase 6 Step 21A Ã¢â‚¬â€ internal FastAPI foundation
AI_SERVICE_DRIVER=disabled
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=
AI_SERVICE_VERIFY_TLS=false
AI_ALLOW_INTERNAL_HTTP=true
AI_SERVICE_HEALTH_ENDPOINT=/health/ready
AI_SERVICE_VERSION_ENDPOINT=/version
AI_SERVICE_ANALYTICS_CONTRACT_ENDPOINT=/internal/v1/contracts/analytics/validate
AI_CONNECT_TIMEOUT_SECONDS=2
AI_REQUEST_TIMEOUT_SECONDS=5
AI_RETRY_ATTEMPTS=2
AI_RETRY_DELAY_MILLISECONDS=150
AI_MAXIMUM_REQUEST_BYTES=1048576
AI_MAXIMUM_RESPONSE_BYTES=262144
AI_USER_AGENT=SmartFactory-DSS/1.0
AI_LOG_CHANNEL=stack

# Phase 6 Step 21C â€” reproducible sanitized dataset snapshots
# Native Windows setup uses D:/SmartFactoryDSS/datasets.
# Docker/Kubernetes will override this with a mounted persistent path.
AI_DATASET_ROOT=
AI_DATASET_TIMEZONE=Africa/Casablanca
AI_DATASET_DEFAULT_LOOKBACK_DAYS=180
AI_DATASET_MAXIMUM_RANGE_DAYS=366
AI_DATASET_MAXIMUM_ROWS_PER_FILE=1000000
AI_DATASET_MAXIMUM_BYTES_PER_FILE=536870912
AI_DATASET_SOURCE_SYSTEM=simulated_sage
AI_DATASET_AUDIT_ENABLED=true
# Phase 6 Step 21M - Laravel AI inference dashboard
AI_INFERENCE_DRIVER=disabled
AI_INFERENCE_MODELS_ENDPOINT=/internal/v1/inference/models
AI_INFERENCE_FORECAST_ENDPOINT=/internal/v1/inference/production/forecast
AI_INFERENCE_ANOMALY_ENDPOINT=/internal/v1/inference/production/anomaly
AI_INFERENCE_MAINTENANCE_RISK_ENDPOINT=/internal/v1/inference/maintenance/risk
AI_INFERENCE_MAXIMUM_REQUEST_BYTES=262144
AI_INFERENCE_MAXIMUM_RESPONSE_BYTES=262144

# Phase 6 Step 21O - verified model metrics for AI reports
AI_INFERENCE_METRICS_ENDPOINT=/internal/v1/inference/models/{model_run_id}/metrics/{task}

# Phase 7 Step 22E - guarded Laravel-to-FastAPI explanations
# Values fall back to the existing AI_SERVICE_* settings when left unset.
AI_EXPLANATION_DRIVER=fastapi
AI_EXPLANATION_BASE_URL=http://127.0.0.1:8001
AI_EXPLANATION_TOKEN=
AI_EXPLANATION_VERIFY_TLS=false
AI_EXPLANATION_ALLOW_INTERNAL_HTTP=true
AI_EXPLANATION_ENDPOINT=/internal/v1/explanations/generate
AI_EXPLANATION_CONNECT_TIMEOUT_SECONDS=2
AI_EXPLANATION_TIMEOUT_SECONDS=90
AI_EXPLANATION_MAXIMUM_REQUEST_BYTES=65536
AI_EXPLANATION_MAXIMUM_RESPONSE_BYTES=65536
AI_EXPLANATION_USER_AGENT=SmartFactory-DSS/1.0
AI_EXPLANATION_LOG_CHANNEL=stack
AI_EXPLANATION_SNAPSHOT_TTL_MINUTES=15
AI_EXPLANATION_MAXIMUM_SESSION_SNAPSHOTS=10
