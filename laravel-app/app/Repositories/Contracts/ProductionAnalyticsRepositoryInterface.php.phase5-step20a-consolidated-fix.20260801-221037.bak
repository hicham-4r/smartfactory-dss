<?php

namespace App\Repositories\Contracts;

use App\DTOs\Analytics\AnalyticsFilter;
use Illuminate\Support\Collection;

interface ProductionAnalyticsRepositoryInterface
{
    /**
     * Aggregate validated production records in the selected period.
     *
     * @return list<object>
     */
    public function validatedProductionByUnit(
        AnalyticsFilter $filter
    ): array;

    /**
     * Aggregate scheduled production-order targets in the selected period.
     *
     * @return list<object>
     */
    public function scheduledTargetsByUnit(
        AnalyticsFilter $filter
    ): array;

    /**
     * Return a bounded list for the production-order filter.
     *
     * @return Collection<int, object>
     */
    public function filterableProductionOrders(
        AnalyticsFilter $filter,
        int $limit = 250
    ): Collection;

    /**
     * Return canonical active shifts for analytics filters.
     * Case-only duplicates with the same time window are represented once.
     *
     * @return Collection<int, object>
     */
    public function filterableShifts(): Collection;

    /**
     * Return period-specific combinations used to prevent impossible filters.
     *
     * @return list<array{
     *     production_line_id:int,
     *     product_family_id:int,
     *     product_id:int,
     *     shift_key:?string,
     *     status:string
     * }>
     */
    public function filterCompatibilityRows(
        AnalyticsFilter $filter,
        int $limit = 5000
    ): array;
}
