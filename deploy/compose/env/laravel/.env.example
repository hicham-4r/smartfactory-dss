APP_NAME="SmartFactory DSS"
APP_ENV=container
APP_KEY=__LARAVEL_APP_KEY__
APP_DEBUG=false
APP_URL=https://localhost:8443
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
AUTH_PASSWORD_TIMEOUT=900
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql-dss
DB_PORT=3306
DB_DATABASE=smartfactory_dss
DB_USERNAME=smartfactory_dss
DB_PASSWORD=__DSS_DB_PASSWORD__
DB_QUEUE_RETRY_AFTER=7500

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_FROM_ADDRESS=smartfactory@example.invalid
MAIL_FROM_NAME="${APP_NAME}"

ERP_CONNECTOR=simulated_sage
ERP_SIMULATED_SAGE_BASE_URL=http://nginx:8082
ERP_SIMULATED_SAGE_TOKEN=__ERP_API_TOKEN__
ERP_SIMULATED_SAGE_VERIFY_TLS=false
ERP_SIMULATED_SAGE_HEALTH_ENDPOINT=/api/health
ERP_CONNECT_TIMEOUT_SECONDS=5
ERP_REQUEST_TIMEOUT_SECONDS=20
ERP_RETRY_ATTEMPTS=3
ERP_RETRY_DELAY_MILLISECONDS=250
ERP_RETRY_MAXIMUM_DELAY_MILLISECONDS=5000
ERP_PAGE_SIZE=100
ERP_MAXIMUM_PAGE_SIZE=100
ERP_MAXIMUM_RESPONSE_BYTES=5242880
ERP_USER_AGENT=SmartFactory-DSS/1.0
ERP_SYNC_AUTOMATION_ENABLED=false
ERP_MANUAL_SYNC_QUEUE=erp-sync

AI_SERVICE_DRIVER=fastapi
AI_INFERENCE_DRIVER=fastapi
AI_EXPLANATION_DRIVER=fastapi
AI_SERVICE_BASE_URL=http://fastapi-ai:8001
AI_SERVICE_TOKEN=__AI_INTERNAL_TOKEN__
AI_SERVICE_VERIFY_TLS=false
AI_ALLOW_INTERNAL_HTTP=true
AI_SERVICE_HEALTH_ENDPOINT=/health/ready
AI_SERVICE_VERSION_ENDPOINT=/version
AI_SERVICE_ANALYTICS_CONTRACT_ENDPOINT=/internal/v1/contracts/analytics/validate
AI_CONNECT_TIMEOUT_SECONDS=2
AI_REQUEST_TIMEOUT_SECONDS=5
AI_RETRY_ATTEMPTS=2
AI_RETRY_DELAY_MILLISECONDS=150
AI_MAXIMUM_REQUEST_BYTES=1048576
AI_MAXIMUM_RESPONSE_BYTES=262144
AI_USER_AGENT=SmartFactory-DSS/1.0
AI_LOG_CHANNEL=stderr
AI_EXPLANATION_TIMEOUT_SECONDS=90

ANALYTICS_TIMEZONE=Africa/Casablanca
PRODUCTION_RECORD_EDIT_WINDOW_HOURS=48
